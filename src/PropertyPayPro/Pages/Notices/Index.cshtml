@page
@model PropertyPayPro.Pages.Notices.IndexModel
@using PropertyPayPro.Pages.Shared
@{
    ViewData["Title"] = "Notices";
    var isAdmin = User.IsInRole(IdentitySeed.AdminRole);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Notices</h1>
        <div class="text-muted">Every formal notice generated across all leases.</div>
    </div>
    <div>
        <a asp-page="Broadcast" class="btn btn-outline-info">
            <i class="las la-bullhorn"></i> Broadcast
        </a>
        @if (isAdmin)
        {
            <a asp-page="Create" class="btn btn-success">
                <i class="las la-plus"></i> New Notice
            </a>
        }
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show">@msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">@err
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <partial name="_KpiCard" model="@(new KpiCardModel {
        Label = "Notices on File", Value = Model.TotalCount.ToString(),
        Color = "primary", Icon = "flaticon-381-list" })" />
    <partial name="_KpiCard" model="@(new KpiCardModel {
        Label = "In the Last 30 Days", Value = Model.Last30DaysCount.ToString(),
        Color = "info", Icon = "flaticon-381-time" })" />
    <partial name="_KpiCard" model="@(new KpiCardModel {
        Label = "Delivered to Tenant", Value = Model.SentCount.ToString(),
        Color = "success", Icon = "flaticon-381-send" })" />
    <partial name="_KpiCard" model="@(new KpiCardModel {
        Label = "Properties", Value = Model.Properties.Count.ToString(),
        Color = "warning", Icon = "flaticon-381-home-2" })" />
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-6">
                <input asp-for="Q" class="form-control" placeholder="Search notice title, filename, property..." />
            </div>
            <div class="col-md-4">
                <select asp-for="PropertyFilter" class="form-select">
                    <option value="">All properties</option>
                    @foreach (var p in Model.Properties)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped mb-0 js-datatable" data-order='[[3,"desc"]]'>
                <thead>
                    <tr>
                        <th>Notice</th>
                        <th>Property / Lease</th>
                        <th>Effective</th>
                        <th>Generated</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Notices)
                {
                    <tr>
                        <td>
                            <span class="fw-semibold">@(d.Description ?? d.FileName)</span>
                            <br /><small class="text-muted">@d.FileName</small>
                        </td>
                        <td>
                            <div>@d.Lease?.Property?.Name</div>
                            <small class="text-muted">@d.Lease?.TenantNames</small>
                        </td>
                        <td>@(d.EffectiveDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>@d.UploadedOn.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (d.SentCount > 0)
                            {
                                <span class="badge bg-success"
                                      title="Last sent @d.LastSentUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">
                                    Sent @d.SentCount×
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark">Draft</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-page="/Documents/Preview" asp-route-id="@d.Id"
                                   class="btn btn-outline-info" title="Preview PDF">
                                    <i class="las la-file-pdf"></i>
                                </a>
                                @if (isAdmin)
                                {
                                    <a asp-page="Edit" asp-route-id="@d.Id"
                                       class="btn btn-outline-warning" title="Edit + regenerate">
                                        <i class="las la-edit"></i>
                                    </a>
                                    <a asp-page="Send" asp-route-id="@d.Id"
                                       class="btn btn-outline-success" title="Compose email + send">
                                        <i class="las la-paper-plane"></i>
                                    </a>
                                }
                                <a asp-page="/Leases/Details" asp-route-id="@d.LeaseId"
                                   class="btn btn-outline-secondary" title="Open lease">
                                    <i class="las la-link"></i>
                                </a>
                                @if (isAdmin)
                                {
                                    <form method="post" asp-page-handler="Delete"
                                          asp-route-id="@d.Id" class="d-inline"
                                          onsubmit="return confirm('Delete this notice? The stored PDF will be removed. Recipients who were already emailed keep their copy.');">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                            <i class="las la-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Notices.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">
                        No notices yet.
                        @if (isAdmin)
                        {
                            <a asp-page="Create">Create one</a>
                            @:.
                        }
                    </td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
