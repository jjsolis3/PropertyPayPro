@*
    Sub-navigation pills shared across all /Settings/* pages.
*@
@{
    string? active = ViewData["SettingsTab"] as string;
    bool Is(string id) => string.Equals(active, id, StringComparison.OrdinalIgnoreCase);
}

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a asp-page="/Settings/Branding" class="nav-link @(Is("branding") ? "active" : "")">Branding</a>
    </li>
    <li class="nav-item">
        <a asp-page="/Settings/Email" class="nav-link @(Is("email") ? "active" : "")">Email</a>
    </li>
    <li class="nav-item">
        <a asp-page="/Settings/Billing" class="nav-link @(Is("billing") ? "active" : "")">Billing</a>
    </li>
    <li class="nav-item">
        <a asp-page="/Users/Index" class="nav-link @(Is("users") ? "active" : "")">Users</a>
    </li>
    <li class="nav-item">
        <a asp-page="/Settings/Templates/Index" class="nav-link @(Is("templates") ? "active" : "")">Templates</a>
    </li>
    <li class="nav-item">
        <a asp-page="/Settings/Scheduler" class="nav-link @(Is("scheduler") ? "active" : "")">Scheduler</a>
    </li>
    <li class="nav-item">
        <a asp-page="/Settings/EmailLogs" class="nav-link @(Is("emaillogs") ? "active" : "")">Email Logs</a>
    </li>
    <li class="nav-item">
        <a asp-page="/Settings/Audit" class="nav-link @(Is("audit") ? "active" : "")">Audit Log</a>
    </li>
</ul>
