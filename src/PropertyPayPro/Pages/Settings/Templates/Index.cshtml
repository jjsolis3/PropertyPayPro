@page
@model PropertyPayPro.Pages.Settings.Templates.IndexModel
@using PropertyPayPro.Models
@{
    ViewData["Title"] = "Templates";
    ViewData["SettingsTab"] = "templates";
}

<h1 class="h3 mb-3">Notice Templates</h1>
<partial name="_SettingsNav" />

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show">@msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@functions {
    void RenderGroup(string title, string blurb, List<NoticeTemplate> rows)
    {
        <div class="card mb-3">
            <div class="card-header">
                <strong>@title</strong>
                <div class="small text-muted">@blurb</div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Label</th>
                            <th>Slug</th>
                            <th>Title / Subject</th>
                            <th>Type</th>
                            <th>Updated</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var t in rows)
                    {
                        <tr class="@(t.IsActive ? "" : "text-muted")">
                            <td><strong>@t.Label</strong></td>
                            <td><code class="small">@t.Slug</code></td>
                            <td><small>@(t.TitleOrSubject ?? "—")</small></td>
                            <td>
                                @if (t.IsSystem)
                                {
                                    <span class="badge bg-info">System</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Custom</span>
                                }
                                @if (!t.IsActive)
                                {
                                    <span class="badge bg-light text-dark">Hidden</span>
                                }
                            </td>
                            <td><small>@t.UpdatedUtc.ToLocalTime().ToString("yyyy-MM-dd")</small></td>
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@{
    RenderGroup("Notice PDF bodies",
        "Used on /Notices/Create. Pick-list for the admin when generating a new notice PDF.",
        Model.PdfBodies);
    RenderGroup("Cover email templates",
        "Used on /Notices/Send. Pre-fills the subject and body when sending a notice package.",
        Model.CoverEmails);
    RenderGroup("Recurring reminder emails",
        "Used by the background scheduler for late rent, lease renewal, and inspection reminders.",
        Model.SystemReminders);
}
